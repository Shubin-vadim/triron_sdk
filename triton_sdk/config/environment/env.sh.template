# Copy to env.sh (git-ignored) and `source` it. SDK settings use the TRITON_ prefix.
export TRITON_URL=localhost:8000
export TRITON_PROTOCOL=http            # http | grpc (grpc default port is 8001)
export TRITON_DEFAULT_MODEL=vllm_model # change to the model name in your Triton model repository
export TRITON_BACKEND=                 # tensorrt_llm | vllm | generic | empty = auto-detect
export TRITON_TIMEOUT=60
export TRITON_STREAM_TIMEOUT=300
export TRITON_CONNECT_TIMEOUT=5
export TRITON_RETRY_COUNT=3
export TRITON_RETRY_START_TIMEOUT=1
export TRITON_VERIFY_SSL=true            # httpx only; gRPC always verifies
export TRITON_SSL=false                  # or use grpcs:// / https:// in TRITON_URL
export TRITON_SSL_ROOT_CERT=             # CA bundle (PEM), empty = system roots
export TRITON_SSL_CLIENT_CERT=           # mTLS client cert (PEM)
export TRITON_SSL_CLIENT_KEY=            # mTLS client key (PEM), empty = same file as cert
export TRITON_SSL_SERVER_NAME_OVERRIDE=  # gRPC ssl_target_name_override
export TRITON_TOKEN=
export TRITON_CHAT_TEMPLATE_MODEL=     # HF tokenizer id for chat templates, e.g. Qwen/Qwen2.5-0.5B-Instruct
export TRITON_LOG_LEVEL=INFO
# Optional endpoint overrides used by examples and integration tests:
export TRITON_GRPC_URL=localhost:8001
export TRITON_OPENAI_URL=              # leave empty if no OpenAI-compatible frontend is running
